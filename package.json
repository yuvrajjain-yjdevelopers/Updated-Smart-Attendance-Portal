{
  "name": "smart-attendance-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema prisma/schema.sqlite.prisma && next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "admin:create": "node --env-file=.env scripts/create-hod.mjs",
    "admin:create:production": "prisma generate --schema prisma/schema.prisma && node --env-file=.env.production.local scripts/create-hod.mjs",
    "start": "next start",
    "lint": "eslint src prisma scripts vitest.config.mts next.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "prisma generate --schema prisma/schema.sqlite.prisma && node --env-file=.env prisma/seed.mjs",
    "db:push:local": "prisma db push --schema prisma/schema.sqlite.prisma",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "papaparse": "^5.7.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
