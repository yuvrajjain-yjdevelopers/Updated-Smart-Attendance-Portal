generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  HOD
  TEACHER
}

enum SmsGatewayMode {
  LOCAL
  CLOUD
}

enum MessageChannel {
  SMS
  WHATSAPP
}

enum PreparedStatus {
  READY
  MISSING_NUMBER
  SENT
  OPENED
  SKIPPED
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  OPENED
  SKIPPED
  SENT_BY_USER
}

enum ConnectionKind {
  WHATSAPP_WEB
  MOBILE_LINK
}

enum MobileLinkMode {
  SMS_LINK
  GOOGLE_MESSAGES
  PHONE
}

enum SendSessionStatus {
  PREPARED
  IN_PROGRESS
  PAUSED_SETUP
  COMPLETED
  CANCELLED
}

enum SendSessionItemStatus {
  PENDING
  OPENED
  SENT_BY_USER
  SKIPPED
  FAILED
  EXCLUDED
}

model User {
  id                             String          @id @default(cuid())
  username                       String          @unique
  name                           String
  passwordHash                   String
  role                           Role            @default(TEACHER)
  sectionId                      String?
  section                        Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  canSend                        Boolean         @default(true)
  canMarkDailyAttendance        Boolean         @default(true)
  mobileLinkMode                 MobileLinkMode  @default(SMS_LINK)
  active                         Boolean         @default(true)
  mobile                         String?
  smsGatewayMode                 SmsGatewayMode?
  smsGatewayUrl                  String?
  smsGatewayUser                 String?
  smsGatewayPassEnc              String?
  smsGatewaySenderNumber         String?
  smsGatewayLastTestAt           DateTime?
  smsGatewayLastSuccessfulTestAt DateTime?
  smsGatewayLastTestOk           Boolean?
  lastLoginAt                    DateTime?
  preparedMessages              PreparedMessage[]
  batches                        MessageBatch[]
  sendSessions                   SendSession[]
  dailyAttendanceMarked          DailyAttendance[]
  dailyAttendanceAudits          DailyAttendanceAudit[]
  messagingConnections           MessagingConnection[]
  createdAt                      DateTime        @default(now())
}

model Section {
  id        String            @id @default(cuid())
  name      String            @unique
  users     User[]
  students  Student[]
  batches   MessageBatch[]
  sendSessions SendSession[]
  uploads   DetentionUpload[]
  dailyAttendances DailyAttendance[]
  createdAt DateTime          @default(now())
}

model Student {
  id                 String           @id @default(cuid())
  regNo              String           @unique
  name               String
  sectionId          String
  section            Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  parentMobile       String
  studentMobile      String?
  branch             String?
  totalAttendancePct Float?
  avgAtt             Float?
  isDetained         Boolean          @default(false)
  detainedSubjects   String           @default("[]")
  lowSubjectCount    Int              @default(0)
  lastListDate       DateTime?
  updatedAt          DateTime         @default(now()) @updatedAt
  preparedMessages   PreparedMessage[]
  logs               MessageLog[]
  sendSessionItems  SendSessionItem[]
  entries            DetentionEntry[]
  dailyAttendanceEntries DailyAttendanceEntry[]

  @@index([sectionId, regNo])
  @@index([sectionId, avgAtt, lastListDate])
  @@index([sectionId, totalAttendancePct])
}

model DetentionUpload {
  id            String           @id @default(cuid())
  sectionId     String
  section       Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  uploadedById  String
  uptoDate      DateTime
  sourceType    String
  fileName      String
  parsedCount   Int
  matchedCount  Int
  detainedCount Int
  entries       DetentionEntry[]
  createdAt     DateTime         @default(now())

  @@unique([sectionId, uptoDate])
}

model DetentionEntry {
  id               String          @id @default(cuid())
  uploadId         String
  upload           DetentionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  avgAtt           Float
  detainedSubjects String          @default("[]")
}

model MessageBatch {
  id         String       @id @default(cuid())
  sectionId  String
  section    Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sentById   String?
  sentBy     User?        @relation(fields: [sentById], references: [id], onDelete: SetNull)
  senderName String
  channels   String
  total      Int
  testMode   Boolean      @default(false)
  logs       MessageLog[]
  createdAt  DateTime     @default(now())
}

model PreparedMessage {
  id        String         @id @default(cuid())
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channel   MessageChannel
  kind      String         @default("DETENTION")
  status    PreparedStatus @default(READY)
  toNumber  String?
  text      String
  sourceFingerprint String?
  listDate  DateTime?
  sessionItems SendSessionItem[]
  updatedAt DateTime       @updatedAt
  @@unique([studentId, senderId, channel, kind])
  @@index([senderId, status])
}

model MessageLog {
  id         String         @id @default(cuid())
  batchId    String
  batch      MessageBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sentById   String
  senderName String
  channel    MessageChannel
  kind       String         @default("DETENTION")
  status     MessageStatus  @default(QUEUED)
  mode       String?
  error      String?
  listDate   DateTime?
  toNumber   String
  text       String
  sessionItem SendSessionItem?
  createdAt  DateTime       @default(now())
}

model MessagingConnection {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ConnectionKind
  confirmedAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@unique([userId, kind])
}

model SendSession {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      MessageChannel
  kind         String            @default("DETENTION")
  mobileLinkMode MobileLinkMode @default(SMS_LINK)
  sectionId    String
  section      Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  activeKey    String?           @unique
  status       SendSessionStatus @default(PREPARED)
  currentIndex Int               @default(0)
  testMode     Boolean           @default(false)
  items        SendSessionItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, channel, status])
}

model SendSessionItem {
  id                String                @id @default(cuid())
  sessionId         String
  session           SendSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind              String                @default("DETENTION")
  preparedMessageId String?
  preparedMessage   PreparedMessage?      @relation(fields: [preparedMessageId], references: [id], onDelete: SetNull)
  messageLogId      String?               @unique
  messageLog        MessageLog?            @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  status            SendSessionItemStatus @default(PENDING)
  order             Int
  updatedAt         DateTime              @updatedAt

  @@unique([sessionId, order])
  @@index([sessionId, status])
}

model Setting {
  key   String @id
  value String
}

model DailyAttendance {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date        DateTime
  markedById  String?
  markedByName String
  markedBy    User?    @relation(fields: [markedById], references: [id], onDelete: SetNull)
  submittedAt DateTime
  updatedAt   DateTime @updatedAt
  isHoliday   Boolean  @default(false)
  entries     DailyAttendanceEntry[]
  audits      DailyAttendanceAudit[]
  @@unique([sectionId, date])
  @@index([date, sectionId])
}

model DailyAttendanceEntry {
  id                String          @id @default(cuid())
  dailyAttendanceId String
  dailyAttendance   DailyAttendance @relation(fields: [dailyAttendanceId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status            String
  updatedAt         DateTime        @updatedAt
  @@unique([dailyAttendanceId, studentId])
  @@index([studentId, dailyAttendanceId])
}

model DailyAttendanceAudit {
  id                String          @id @default(cuid())
  dailyAttendanceId String
  dailyAttendance   DailyAttendance @relation(fields: [dailyAttendanceId], references: [id], onDelete: Cascade)
  changedById       String?
  changedByName     String
  changedBy         User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  studentId         String?
  field             String
  fromValue         String?
  toValue           String?
  changedAt         DateTime        @default(now())
  @@index([dailyAttendanceId, changedAt])
}
