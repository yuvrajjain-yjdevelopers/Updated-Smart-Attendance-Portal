generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  HOD
  TEACHER
}

enum SmsGatewayMode {
  LOCAL
  CLOUD
}

enum MessageChannel {
  SMS
  WHATSAPP
}

enum PreparedStatus {
  READY
  MISSING_NUMBER
  SENT
  OPENED
  SKIPPED
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  OPENED
  SKIPPED
  SENT_BY_USER
}

model User {
  id                             String          @id @default(cuid())
  username                       String          @unique
  name                           String
  passwordHash                   String
  role                           Role            @default(TEACHER)
  sectionId                      String?
  section                        Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  canSend                        Boolean         @default(true)
  active                         Boolean         @default(true)
  mobile                         String?
  smsGatewayMode                 SmsGatewayMode?
  smsGatewayUrl                  String?
  smsGatewayUser                 String?
  smsGatewayPassEnc              String?
  smsGatewaySenderNumber         String?
  smsGatewayLastTestAt           DateTime?
  smsGatewayLastSuccessfulTestAt DateTime?
  smsGatewayLastTestOk           Boolean?
  lastLoginAt                    DateTime?
  preparedMessages              PreparedMessage[]
  batches                        MessageBatch[]
  createdAt                      DateTime        @default(now())
}

model Section {
  id        String            @id @default(cuid())
  name      String            @unique
  users     User[]
  students  Student[]
  batches   MessageBatch[]
  uploads   DetentionUpload[]
  createdAt DateTime          @default(now())
}

model Student {
  id                 String           @id @default(cuid())
  regNo              String           @unique
  name               String
  sectionId          String
  section            Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  parentMobile       String
  studentMobile      String?
  branch             String?
  totalAttendancePct Float?
  avgAtt             Float?
  isDetained         Boolean          @default(false)
  detainedSubjects   String           @default("[]")
  lowSubjectCount    Int              @default(0)
  lastListDate       DateTime?
  updatedAt          DateTime         @default(now()) @updatedAt
  preparedMessages   PreparedMessage[]
  logs               MessageLog[]
  entries            DetentionEntry[]
}

model DetentionUpload {
  id            String           @id @default(cuid())
  sectionId     String
  section       Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  uploadedById  String
  uptoDate      DateTime
  sourceType    String
  fileName      String
  parsedCount   Int
  matchedCount  Int
  detainedCount Int
  entries       DetentionEntry[]
  createdAt     DateTime         @default(now())

  @@unique([sectionId, uptoDate])
}

model DetentionEntry {
  id               String          @id @default(cuid())
  uploadId         String
  upload           DetentionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  avgAtt           Float
  detainedSubjects String          @default("[]")
}

model MessageBatch {
  id         String       @id @default(cuid())
  sectionId  String
  section    Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sentById   String
  sentBy     User         @relation(fields: [sentById], references: [id])
  senderName String
  channels   String
  total      Int
  testMode   Boolean      @default(false)
  logs       MessageLog[]
  createdAt  DateTime     @default(now())
}

model PreparedMessage {
  id        String         @id @default(cuid())
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channel   MessageChannel
  status    PreparedStatus @default(READY)
  toNumber  String?
  text      String
  listDate  DateTime?
  updatedAt DateTime       @updatedAt
  @@unique([studentId, senderId, channel])
  @@index([senderId, status])
}

model MessageLog {
  id         String         @id @default(cuid())
  batchId    String
  batch      MessageBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sentById   String
  senderName String
  channel    MessageChannel
  status     MessageStatus  @default(QUEUED)
  mode       String?
  error      String?
  listDate   DateTime?
  toNumber   String
  text       String
  createdAt  DateTime       @default(now())
}

model Setting {
  key   String @id
  value String
}
